#这个文件是暴露在外面的 供给传输到公网仓库的

# 复制成 .env 后填入真实值
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的数据库密码
MYSQL_DATABASE=Db_km

DEEPSEEK_API_KEY=你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_TIMEOUT=30

# 百炼业务空间 ID：需要与 API Key 的地域和业务空间对应
DASHSCOPE_WORKSPACE_ID=你的业务空间ID

# 本地 Embedding：local 使用本机服务，aliyun 使用原阿里云配置
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_URL=http://127.0.0.1:8011
